# Copy to backend/.env for local development (all settings: backend/app/core/config.py)
SRECOPILOT_ENV=development
SRECOPILOT_SEED_DEMO=true
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SRECOPILOT_SECRET_KEY=
# none | token | header (behind oauth2-proxy)
SRECOPILOT_AUTH_MODE=none
# token:role:name, comma separated. roles: viewer | operator | admin
SRECOPILOT_AUTH_TOKENS=
SRECOPILOT_REMEDIATION_MODE=approval
SRECOPILOT_AGENT_MAX_STEPS=30
# SRECOPILOT_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/copilot
# SRECOPILOT_BOOTSTRAP_FILE=../deploy/integrations.example.yaml
# SRECOPILOT_PLUGIN_MODULES=["my_company.copilot_plugins"]
